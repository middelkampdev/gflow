{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(gh api:*)",
      "Bash(rtk git add:*)",
      "Bash(rtk git commit:*)",
      "Bash(rtk git push:*)",
      "Bash(rtk git tag:*)",
      "Bash(rtk gh api:*)",
      "Bash(cargo --version)",
      "Bash(cargo test:*)",
      "Bash(cargo build:*)",
      "Bash(cargo llvm-cov:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/tdd-gate.sh",
            "timeout": 600,
            "statusMessage": "TDD gate: tests + coverage ratchet"
          }
        ]
      }
    ]
  }
}